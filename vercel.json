{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/token", "dest": "/api/token.js" },
    { "src": "/api/config", "dest": "/api/config.js" },
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    { "source": "/js/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" } ] },
    { "source": "/css/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" } ] },
    { "source": "/index.html", "headers": [ { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" } ] }
  ]
}
